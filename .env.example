# ──────────────────────────────────────────────────────────────────────
# HostelOS environment variables
#
# Copy this file to `.env.local` for local dev. For production, paste
# these into your host's environment (Vercel project settings, etc.).
# Never commit `.env.local` — it's git-ignored.
# ──────────────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────────────
# Project URL + anon key from Supabase dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Service role key — bypasses RLS. Required by server-side code that
# needs cross-tenant access (controller pages, public OTP/ticket flows,
# audit log writes). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_jwt_form

# JWT-form service role — needed for direct Supabase Auth Admin API
# calls (user create / update / delete). The newer `sb_secret_*` form
# is rejected on some auth.admin endpoints, so we keep both.
SUPABASE_SERVICE_ROLE_JWT=eyJhbGci...your_service_role_jwt

# ── Supabase Management API (required) ────────────────────────────────
# Personal Access Token from supabase.com → Account → Access Tokens.
# Used to run raw SQL against the auth.* schema (which PostgREST doesn't
# expose) for the Mumbai-migration auth backfill on every new signup.
SUPABASE_MGMT_TOKEN=sbp_your_pat
SUPABASE_MUMBAI_REF=your_project_ref

# ── Auth mode (required for production) ───────────────────────────────
# "strict"  → real auth gates enforced on every protected route + action
# (anything else / unset) → demo mode, no real auth (DEV ONLY)
AUTH_MODE=strict

# ── Email delivery (required for OTPs + reminders) ────────────────────
# Preferred: Gmail SMTP via App Password.
#   1. Turn on 2FA at https://myaccount.google.com/security
#   2. Generate App Password at https://myaccount.google.com/apppasswords
#   3. Paste 16-char password below WITHOUT the spaces Google shows.
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your16charapppassword
SMTP_FROM="HostelOS <youraccount@gmail.com>"
# Optional overrides (defaults: smtp.gmail.com:465 over TLS):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Fallback: Resend API. Used only if SMTP_USER/SMTP_PASS are unset.
# Free tier requires a verified sending domain to email arbitrary recipients.
RESEND_API_KEY=
RESEND_FROM="HostelOS <noreply@yourdomain.com>"

# ── Public URL (set after first deploy, then redeploy) ────────────────
# Origin of the deployed app. Used to build absolute URLs in WhatsApp
# reminders + email reminders (the /pay/[id] confirm link, /report-issue
# link). Until set, links point at the request host (localhost in dev,
# the LAN IP in your test server) and won't work for real residents.
APP_PUBLIC_URL=https://your-app.vercel.app

# ── Cron endpoint auth (required for daily email reminders) ───────────
# Random shared secret. Vercel Cron auto-attaches this as a Bearer token.
# Generate with: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
CRON_SECRET=

# ── Sentry (optional — error tracking) ────────────────────────────────
# Leave blank to disable. Add the same DSN to both vars.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time only (lets stack traces show real source instead of minified):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Tokyo region (legacy fallback, optional) ──────────────────────────
# Project ref of the paused Tokyo Supabase. Restorable for 90 days post-pause.
SUPABASE_TOKYO_REF=
